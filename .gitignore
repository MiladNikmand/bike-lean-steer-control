# ============================================================
#  bike-lean-steer-control — .gitignore
# ============================================================

# ---- Generated run folders (can be large) -----------------
Bike_Control_Run_*/

# ---- Report data bundle (regenerated by bc_build_report) --
# NOTE: report_data.js IS committed to the repo so GitHub Pages can serve it.
# Regenerate locally with bc_build_report, then commit and push the new file.
# report_data.js   <-- do NOT uncomment this line

# ---- MATLAB autosave and temp files -----------------------
*.asv
*.m~
octave-workspace

# ---- MATLAB compiled / MEX files --------------------------
*.mex*
*.mexw64
*.mexa64
*.mexmaci64
*.slxc
*.autosave

# ---- Simulation output files (optional — uncomment to track)
# *.mat

# ---- OS junk ----------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE -----------------------------------------
.vscode/
.idea/
*.swp
*~
